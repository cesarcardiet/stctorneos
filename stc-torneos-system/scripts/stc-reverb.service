[Unit]
Description=STC Torneos Laravel Reverb (WebSockets)
After=network.target

[Service]
User=apache
Group=apache
Restart=always
RestartSec=3
WorkingDirectory=/var/www/stc-torneos
ExecStart=/usr/bin/php /var/www/stc-torneos/artisan reverb:start --host=0.0.0.0 --port=8080
Nice=5

[Install]
WantedBy=multi-user.target
